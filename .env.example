# Server Configuration
# NOTE: main.ts defaults to 3002 when PORT is unset.
PORT=3002
NODE_ENV=development

# Serve Swagger at /docs. Off automatically when NODE_ENV=production unless
# this is explicitly "true".
ENABLE_SWAGGER=

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/med_app

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Native sign-in (POST /auth/google/mobile): every client id the app may mint
# ID tokens with. Any of these (or GOOGLE_CLIENT_ID above) is accepted as the
# token audience; the route 401s everything while none are set.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Apple Sign-In (POST /auth/apple). Audience check for the identity token;
# defaults to com.coldtech.medapp when unset.
APPLE_BUNDLE_ID=com.coldtech.medapp

# Transactional email (password reset codes). Uses Resend's HTTP API; when
# RESEND_API_KEY is unset the code is logged to the server console instead,
# so the flow stays testable in development.
RESEND_API_KEY=
MAIL_FROM=ReMed <onboarding@resend.dev>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Groq AI
GROQ_API_KEY=your_groq_api_key_here

SENTRY_DSN=
# Defaults to 0.1 in production and 1.0 otherwise. Tracing every request while
# a cron fires each minute exhausts the free Sentry quota within days.
SENTRY_TRACES_SAMPLE_RATE=
# Tags every event with a release so stack traces can be mapped back to source
# instead of dist/ line numbers. Set at deploy time, e.g. a git sha.
SENTRY_RELEASE=

POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Billing (RevenueCat)
# The full Authorization header value set on the RevenueCat webhook, compared
# verbatim — include the "Bearer " prefix if you configured one there.
# POST /billing/webhook refuses every request while this is unset.
REVENUECAT_WEBHOOK_SECRET=